#!/usr/bin/env bash
# Rejects commit subjects that are not Conventional Commits: type(scope): summary
# See memory-kit/standards/git-commits.md. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

subject=$(head -n 1 "$1")

# Let git's own generated subjects through (merges, reverts, fixup/squash from autosquash).
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|docs|refactor|perf|test|build|ci|chore|revert|style'
if ! [[ "$subject" =~ ^($types)(\([a-z0-9][a-z0-9-]*\))?!?:\ .+ ]]; then
  echo "commit-msg: subject must be 'type(scope): summary' with type one of: ${types//|/, }" >&2
  echo "  got: $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; the limit is 72" >&2
  exit 1
fi

if [[ "$subject" =~ \.$ ]]; then
  echo "commit-msg: subject must not end with a period" >&2
  exit 1
fi
